{
	"name": "@axnic/n8n-nodes-paperless-ngx",
	"version": "0.1.2",
	"description": "N8N community node manage your documents with Paperless-ngx.",
	"keywords": [
		"n8n-community-node-package",
		"paperless",
		"paperless-ngx"
	],
	"license": "MIT",
	"homepage": "https://github.com/axnic/n8n-nodes-paperless-ngx#readme",
	"author": {
		"name": "Alexandre NICOLAIE",
		"email": "xunleii@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/axnic/n8n-nodes-paperless-ngx.git"
	},
	"engines": {
		"node": ">=22.16",
		"pnpm": ">=9.1"
	},
	"packageManager": "pnpm@9.15.4",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials --write",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/PaperlessApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Paperless/Paperless.node.js"
		],
		"strict": true
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.5",
		"@types/node": "^22.20.5",
		"eslint": "^9.39.5",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/axnic/n8n-nodes-paperless-ngx/issues"
	},
	"pnpm": {
		"overrides": {
			"handlebars": "^4.7.10",
			"qs": "^6.16.0",
			"stream-json": "^3.6.0"
		}
	}
}
